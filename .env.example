# Copy to .env.local and fill in. Never commit .env.local.

LLM_PROVIDER=groq            # groq | gemini | ollama | anthropic | openai
EMBEDDING_PROVIDER=ollama    # ollama | gemini | openai
EMBEDDING_DIM=768
LLM_CONCURRENCY=2            # free tiers run 15-30 RPM; keep this low

GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/signal_room

# Not in CLAUDE.md's list, but LLM_PROVIDER accepts these paid providers:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
