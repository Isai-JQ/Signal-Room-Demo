# Copy to .env.local and fill in. Never commit .env.local.

LLM_PROVIDER=groq            # groq | gemini | ollama | anthropic | openai
EMBEDDING_PROVIDER=ollama    # ollama | gemini | openai
EMBEDDING_DIM=768
LLM_CONCURRENCY=2            # free tiers run 15-30 RPM; keep this low

# Measured against the seed corpus with nomic-embed-text, not chosen in theory.
# At 0.75 nothing but a decorated copy of the same sentence lands inside the
# cut-off, so the densest neighbourhood is whichever line got sampled most and
# the signal comes out about the video instead of the product; at 0.70 genuine
# paraphrases reach each other. 0.90 is where an opener and an emoji stop making
# one sentence look like two distinct wordings. Re-measure if the model changes.
ANALYST_SIMILARITY_THRESHOLD=0.70  # cosine cut-off for "same theme"; tune on the corpus
NEAR_DUPLICATE_THRESHOLD=0.90      # above this, two comments count as one for cluster density

GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/signal_room

# Not in CLAUDE.md's list, but LLM_PROVIDER accepts these paid providers:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
